# Optional local app configuration. npm run app and npm start load .env.local if present.
# Other scripts require exported environment variables (see README).
# Never commit actual credentials or generated binding files.

# Prepared data selection: off disables the prepared prototype. Otherwise the app auto-loads
# ignored .local/prototype/config.json if present, or accepts an explicit path.
# MEMORYNET_PROTOTYPE_CONFIG=off

# New setup workspaces open locally. Existing GitHub client IDs or prepared access keys
# keep their login gate by default. Explicit modes: local (single operator, no sign-in),
# sandbox (test personas), access-key, or github (verified sign-in and repository access).
# MEMORYNET_AUTH_MODE=local

# Embedded database; default .data/memorynet. One process at a time.
# A configured prototype dataDir takes precedence for app startup. Other scripts
# do not read prototype config; explicitly export the intended data directory.
# MEMORYNET_DATA_DIR=.data/memorynet

# Optional Meta extraction. You may instead use the local /settings/meta form;
# form-entered keys stay in server memory until the server exits.
MODEL_API_KEY=
MEMORYNET_META_AGENT_ID=
# Integer 1-20, default 5; resets on restart. Not a monetary cap.
MEMORYNET_META_MAX_REQUESTS=

# Optional owner-only MCP credential file. npm run setup writes one under .local/memorynet/
# and npm start uses it; npm run mcp:binding creates a read-only one. Grants no
# project/repository roles. Keep the file ignored and chmod 600.
# MEMORYNET_AGENT_BINDING_FILE=
# MCP client loopback URL; default http://127.0.0.1:3050.
# MEMORYNET_APP_URL=http://127.0.0.1:3050

# Optional "Connect GitHub" in local mode (OAuth device flow, linked account verification only). Use the client ID of a GitHub App, or of an OAuth App with
# "Enable Device Flow" checked; no client secret is needed. Link each person first: npm run github:link -- --login <you>.
# A client ID defaults to GitHub sign-in for compatibility. Set MEMORYNET_AUTH_MODE=local
# explicitly for optional account connection without a login gate. In GitHub mode,
# repository access is checked with GitHub at sign-in and
# every 5 minutes, expires after 15 minutes, and access declared before startup is ignored.
# MEMORYNET_GITHUB_CLIENT_ID=
# OAuth App scopes, for example repo for private repositories. Leave empty for a GitHub App.
# MEMORYNET_GITHUB_SCOPE=

# Startup takes a verified backup beside the database (<database>.backups/) before applying pending upgrades.
# MEMORYNET_UPGRADE_BACKUP=off
