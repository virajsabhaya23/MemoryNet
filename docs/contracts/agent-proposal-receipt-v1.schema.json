{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "number",
      "const": 1
    },
    "status": {
      "type": "string",
      "const": "pending"
    },
    "reviewPath": {
      "type": "string",
      "pattern": "^\\/proposals\\/[0-9a-f-]{36}$"
    },
    "flags": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "secret_removed",
          "personal_data",
          "truncated",
          "instruction_like"
        ]
      }
    },
    "recordedSourceIds": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "proposalId",
    "revision",
    "status",
    "reviewPath",
    "flags",
    "recordedSourceIds"
  ],
  "additionalProperties": false
}
