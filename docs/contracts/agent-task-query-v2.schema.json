{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "paths": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 300,
      "maximum": 8000
    },
    "maxItems": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    }
  },
  "required": [
    "task"
  ],
  "additionalProperties": false
}
